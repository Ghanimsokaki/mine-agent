{
  "manifest_version": 3,
  "name": "ForgePilot Browser Bridge",
  "version": "0.1.0",
  "description": "Consent-first relay for approved ForgePilot browser tasks.",
  "permissions": ["storage", "alarms", "tabs", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "ForgePilot Browser Bridge", "default_popup": "popup.html"},
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
