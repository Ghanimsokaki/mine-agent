# Copy this file to .streamlit/secrets.toml for local development, or paste it
# into Streamlit Cloud → App settings → Secrets. Never commit real credentials.

[app]
name = "ForgePilot"
public_url = "http://localhost:8501"
allowed_origins = ["http://localhost:8501"]

# The primary Gemby agent is served from Hugging Face, not OpenRouter.
# Create a fine-grained Hugging Face token that can make Inference Provider calls.
[huggingface]
api_key = ""
model = "hwiiiiiiii/gemby-agent-3b"
chat_endpoint = "https://router.huggingface.co/v1/chat/completions"

# Optional: used for the NVIDIA Nemotron fallback/strong-model choice.
[openrouter]
api_key = ""
nemotron_model = "nvidia/llama-3.1-nemotron-ultra-253b-v1:free"
site_url = "http://localhost:8501"

[supabase]
url = ""
anon_key = ""
# Never put the service_role key in this Streamlit app.

[admin]
email = "emir.erningpraja@gmail.com"

[features]
enable_google_oauth = true
enable_browser_bridge = true
max_upload_mb = 25
