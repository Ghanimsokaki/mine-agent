# Copy this file to .streamlit/secrets.toml before running locally.
# Do not commit secrets.toml. Fill values only in your host's secret manager.

[app]
name = "ForgePilot"
public_url = "http://localhost:8501"
allowed_origins = ["http://localhost:8501"]

[openrouter]
api_key = ""
# The requested model ID is intentionally configurable because free model availability changes.
primary_model = "hwiiiiiiii/gemby-agent-3b:free"
# Strong NVIDIA option on OpenRouter. Confirm availability in your account before deployment.
nemotron_model = "nvidia/llama-3.1-nemotron-ultra-253b-v1:free"
site_url = "http://localhost:8501"

[supabase]
url = ""
anon_key = ""
# Never put the service_role key in this client-facing Streamlit app.

[features]
enable_google_oauth = true
enable_browser_bridge = true
max_upload_mb = 25
